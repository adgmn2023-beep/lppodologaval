# Valores possíveis: manual (padrão), google, mock (somente demonstração).
# Para ativar a API com as credenciais abaixo: GBP_PROVIDER=google.
GBP_PROVIDER=manual
# Estrelas mínimas exibidas na lista de avaliações; não altera a nota média ou total.
GBP_MIN_STARS=4
# Idade máxima das postagens LIVE; até 3 postagens são exibidas.
GBP_POSTS_MAX_AGE_DAYS=90
# Google Business Profile: somente servidor. Nunca usar prefixo NEXT_PUBLIC_.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
# IDs numéricos, sem "accounts/" ou "locations/".
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=
# URL pública oficial do site (necessária para canonical, sitemap e URLs estruturadas).
NEXT_PUBLIC_SITE_URL=
# IDs opcionais de mensuração. Scripts não são carregados quando os valores estão ausentes.
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_WHATSAPP_LABEL=
NEXT_PUBLIC_GA4_ID=
