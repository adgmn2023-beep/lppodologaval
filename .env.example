# Dados reais cadastrados manualmente. Use mock somente para demonstração explícita.
GBP_PROVIDER=manual
# Estrelas mínimas exibidas na lista de avaliações; não altera a nota média ou total.
GBP_MIN_STARS=4
# URL pública oficial do site (necessária para canonical, sitemap e URLs estruturadas).
NEXT_PUBLIC_SITE_URL=
# IDs opcionais de mensuração. Scripts não são carregados quando os valores estão ausentes.
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_WHATSAPP_LABEL=
NEXT_PUBLIC_GA4_ID=
